# 허브 저장소의 .env. Jenkins Credentials 'secretary-env'(Secret file)로 올린다.

# Cloudflare Tunnel 토큰 (터널 만들 때 받은 eyJ... 값)
TUNNEL_TOKEN=

# ── 허브 ───────────────────────────────────────────────
# Cloudflare Access를 거친 요청만 받기 (cloudflared가 붙이는 JWT 헤더 확인)
SECRETARY_REQUIRE_CF_ACCESS=true
# HMAC 타임스탬프 허용 오차(초)
SECRETARY_CLOCK_SKEW_SECONDS=60
# 승인 대기 유효 시간(초). 지나면 자동 만료
SECRETARY_APPROVAL_TTL_SECONDS=300
# 활성 사용자 최대 인원 (한 집 기준)
SECRETARY_MAX_USERS=4

# ── 붙일 모듈 ──────────────────────────────────────────
# 이름=주소, 이름=토큰. 쉼표로 이어서 모듈마다 한 줄씩 늘어난다 (docs/module-contract.md)
# 토큰은 모듈마다 따로 만든다: openssl rand -hex 32
# 같은 토큰을 그 모듈 저장소의 .env(MODULE_TOKEN_<이름>)에도 넣는다.
SECRETARY_MODULES=mail=http://secretary-mail:8080
SECRETARY_MODULE_TOKENS=mail=
